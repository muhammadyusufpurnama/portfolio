{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/api/index.php"
    }
  ]
}
